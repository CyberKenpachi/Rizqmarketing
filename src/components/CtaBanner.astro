---
interface Props {
  heading?: string;
  text?: string;
  label?: string;
}
const {
  heading = 'Ready to grow?',
  text = 'Tell us about your business and we will put together a plan built around your goals.',
  label = 'Get a quote',
} = Astro.props;
---

<div class="cta-banner">
  <div>
    <h2>{heading}</h2>
    <p>{text}</p>
  </div>
  <a href="/contact" class="btn btn-gold">{label}</a>
</div>
