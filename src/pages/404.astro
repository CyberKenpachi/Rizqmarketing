---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Rizq Marketing" description="The page you were looking for could not be found." noindex floatCta={false}>
  <section class="hero-simple" style="text-align:center; max-width:640px; margin:0 auto; padding:120px 0 100px;">
    <div class="eyebrow" style="justify-content:center;">404</div>
    <h1>We couldn't find that page.</h1>
    <p class="sub">The link may be out of date. Head back home or see what we do.</p>
    <div class="hero-ctas" style="justify-content:center; margin-top:28px;">
      <a href="/" class="btn btn-gold">Back to home</a>
      <a href="/services" class="btn btn-ghost">See our services</a>
    </div>
  </section>
</Base>
